# API REST (servicios de métricas, alertas, reglas y reportes)
REACT_APP_API_URL=http://localhost:3001/api

# WebSocket (actualización en tiempo real de métricas y alertas)
REACT_APP_WS_URL=ws://localhost:8080

# API estadística (modelos Z-Score / Isolation Forest / ARIMA-Prophet / CUSUM)
REACT_APP_STATS_API=http://localhost:5000/api

# Entorno (development | staging | production)
REACT_APP_ENV=development